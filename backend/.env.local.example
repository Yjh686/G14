# =============================================================================
# 本机开发用的环境变量模板
#
# 用法：
#   cd backend
#   copy .env.local.example .env.local     # Windows
#   cp .env.local.example .env.local       # Linux / macOS
#   然后填入本机 MySQL 的密码和一个随机 JWT 密钥，再用 ./start-local.ps1 启动。
#
# 为什么要有这个文件：
#   application.yml 里的 DB_PASSWORD 和 APP_JWT_SECRET 都没有默认值
#   （仓库是公开的，写默认值等于把密码和签名密钥一起公开）。
#   直接 `mvn spring-boot:run` 会报 Could not resolve placeholder 'DB_PASSWORD'，
#   这是刻意的 —— 与其静默用一个人人都知道的默认值，不如启动就失败。
#
# `.env.local` 已被根 .gitignore 排除，不会进仓库；`.env.local.example` 会入库。
# =============================================================================

# 本机 MySQL 的 root 密码
DB_PASSWORD=

# JWT 签名密钥，UTF-8 编码后至少 32 字节，否则后端启动时会抛
# IllegalStateException: app.jwt.secret 长度不足 32 字节，HS256 不安全
# 生成方式：openssl rand -base64 48
APP_JWT_SECRET=

# 可选：数据库地址。默认连 localhost:3306 的 G14(1) 库，
# 库名里的括号在 JDBC URL 中要写成 %28 %29。
# 只有连不上默认库时才需要取消注释并修改。
#DB_URL=jdbc:mysql://localhost:3306/G14%281%29?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true

# 可选：数据库账号，默认 root
#DB_USERNAME=root
