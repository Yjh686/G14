{
 "sys_user": {
  "name": "sys_user",
  "cn": "用户表",
  "module": "认证与权限",
  "columns": [
   {
    "name": "id",
    "type": "BIGINT UNSIGNED",
    "not_null": true,
    "default": "",
    "comment": "主键",
    "auto_increment": true,
    "keys": [
     "PK"
    ]
   },
   {
    "name": "username",
    "type": "VARCHAR(64)",
    "not_null": true,
    "default": "",
    "comment": "登录账号：学号/工号/管理员账号",
    "auto_increment": false,
    "keys": [
     "UK"
    ]
   },
   {
    "name": "password_hash",
    "type": "VARCHAR(100)",
    "not_null": true,
    "default": "",
    "comment": "BCrypt 密码哈希（$2a$10$...）",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "real_name",
    "type": "VARCHAR(64)",
    "not_null": true,
    "default": "",
    "comment": "姓名",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "status",
    "type": "TINYINT",
    "not_null": true,
    "default": "1",
    "comment": "状态：1=正常 0=禁用",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "audit_status",
    "type": "TINYINT",
    "not_null": true,
    "default": "1",
    "comment": "审核状态：0=待审核 1=已通过 2=已驳回（ADMIN 导入默认已通过）",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "must_change_password",
    "type": "TINYINT",
    "not_null": true,
    "default": "0",
    "comment": "是否强制下次登录改密：1=是 0=否",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "phone",
    "type": "VARCHAR(20)",
    "not_null": false,
    "default": "NULL",
    "comment": "手机号",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "email",
    "type": "VARCHAR(128)",
    "not_null": false,
    "default": "NULL",
    "comment": "邮箱",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "department",
    "type": "VARCHAR(128)",
    "not_null": false,
    "default": "NULL",
    "comment": "院系/班级",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "token_version",
    "type": "INT",
    "not_null": true,
    "default": "0",
    "comment": "令牌版本：改密/重置/禁用时+1，使旧 JWT 立即失效",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "login_fail_count",
    "type": "INT",
    "not_null": true,
    "default": "0",
    "comment": "连续登录失败次数",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "locked_until",
    "type": "DATETIME",
    "not_null": false,
    "default": "NULL",
    "comment": "锁定截止时间，NULL=未锁定",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "last_login_time",
    "type": "DATETIME",
    "not_null": false,
    "default": "NULL",
    "comment": "最近一次登录成功时间",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "audit_remark",
    "type": "VARCHAR(255)",
    "not_null": false,
    "default": "NULL",
    "comment": "审核意见（驳回原因）",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "remark",
    "type": "VARCHAR(255)",
    "not_null": false,
    "default": "NULL",
    "comment": "备注",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "deleted",
    "type": "TINYINT",
    "not_null": true,
    "default": "0",
    "comment": "逻辑删除：0=未删 1=已删",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "create_by",
    "type": "BIGINT UNSIGNED",
    "not_null": false,
    "default": "NULL",
    "comment": "创建人 ID",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "create_time",
    "type": "DATETIME",
    "not_null": true,
    "default": "CURRENT_TIMESTAMP",
    "comment": "创建时间",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "update_by",
    "type": "BIGINT UNSIGNED",
    "not_null": false,
    "default": "NULL",
    "comment": "更新人 ID",
    "auto_increment": false,
    "keys": []
   },
   {
    "name": "update_time",
    "type": "DATETIME",
    "not_null": true,
    "default": "CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP",
    "comment": "更新时间",
    "auto_increment": false,
    "keys": []
   }
  ],
  "indexes": [
   {
    "name": "PRIMARY",
    "unique": true,
    "primary": true,
    "cols": [
     "id"
    ]
   },
   {
    "name": "uk_username",
    "unique": true,
    "primary": false,
    "cols": [
     "username"
    ]
   },
   {
    "name": "idx_status",
    "unique": false,
    "primary": false,
    "cols": [
     "status",
     "deleted"
    ]
   },
   {
    "name": "idx_audit",
    "unique": false,
    "primary": false,
    "cols": [
     "audit_status",
     "deleted"
    ]
   },
   {
    "name": "idx_phone",
    "unique": false,
    "primary": false,
    "cols": [
     "phone"
    ]
   }
  ],
  "file": "01_schema_auth.sql"
 },
