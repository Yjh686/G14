# =============================================================================
# 部署环境变量模板
#
# 用法：
#   cd deploy
#   copy .env.example .env      # Windows
#   cp .env.example .env        # Linux / macOS
#   然后按需改下面几项，docker compose 会自动读取同目录的 .env
#
# 注意：`.env` 已在根 .gitignore 里排除，不会被提交。
# =============================================================================

# ---------------------------------------------------------------------------
# 必改项
# ---------------------------------------------------------------------------

# MySQL root 密码。容器首次初始化时写入数据卷，**改了之后旧数据卷不会跟着变**，
# 要全新密码必须 docker compose down -v 重建。
MYSQL_ROOT_PASSWORD=change-me-please

# JWT 签名密钥。必须 >= 32 字节（HS256 要求），否则后端启动即抛
# IllegalStateException: app.jwt.secret 长度不足 32 字节。
# 换了它，所有已签发的令牌立即失效 —— 这正是「强制全体重新登录」的手段。
APP_JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes

# ---------------------------------------------------------------------------
# 可选项
# ---------------------------------------------------------------------------

# 前端容器对外端口绑定。默认 80:80，直接公网可访问 http://<服务器IP>。
# 若要套宿主机 nginx 做 HTTPS（有域名时的推荐做法），改成 127.0.0.1:8080:80，
# 让容器的 80 只监听回环，公网 80/443 交给宿主机 nginx + certbot。
FRONTEND_PUBLISH=80:80

# 后端容器端口绑定。默认只绑回环，供本机 curl 排障用；公网不暴露。
BACKEND_PUBLISH=127.0.0.1:8080:8080

# MySQL 端口绑定。默认只绑回环。开发机上若已装 MySQL 占着 3306，
# 改成 127.0.0.1:13306:3306 即可；生产机建议直接注释/删掉这一行，
# 让 MySQL 只存在于 compose 内部网络（backend 通过服务名 mysql 访问）。
MYSQL_PUBLISH=127.0.0.1:3306:3306

# 后端容器内存上限。JVM 的 -XX:MaxRAMPercentage=75 是相对「容器可见内存」算的，
# 不设上限时它看到的是宿主机内存，2G 小机器上会被 OOM Killer 直接干掉。
BACKEND_MEM=1g

# 初始密码（管理员新建账号 / 批量导入 / 重置密码时使用）不在环境变量里配置。
# 它是 FR-CFG-02 的在线可改项，真实来源是 sys_config 表的
# security.default-password，建库后登录「系统配置」页修改即可。
