# =============================================================================
# 前端镜像：构建 Vue 静态产物 → 交给 Nginx 托管并反代 /api
#
# 与后端同样的两阶段思路：Node 只用来 build，产物是一个几十 MB 的静态目录，
# 没必要把 Node 和 node_modules 一起打进运行时镜像。
#
# 构建：docker build -f deploy/Dockerfile.frontend -t g14/frontend .
# =============================================================================

# ------------------------------- 构建阶段 -------------------------------
FROM node:22-alpine AS build

WORKDIR /build

# 同理先只拷依赖清单，命中 Docker 层缓存
COPY frontend/G14/package.json frontend/G14/package-lock.json* ./
# npm ci 要求 lock 文件存在且完全匹配；没有 lock 时退回 npm install
RUN if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; \
    else npm install --no-audit --no-fund; fi

COPY frontend/G14/ ./
# vue-tsc 类型检查在 CI 里单独跑，这里只做产物构建，避免构建失败于纯类型问题
RUN npm run build

# ------------------------------- 运行阶段 -------------------------------
FROM nginx:1.27-alpine

# 镜像自带的默认站点配置会抢占 80 端口，先删掉
RUN rm -f /etc/nginx/conf.d/default.conf

COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html

EXPOSE 80

# 前台运行，便于 docker 收集日志（nginx 默认配置就是 daemon off 之外的写法，
# 这里显式给出，避免基础镜像策略变化）
CMD ["nginx", "-g", "daemon off;"]
