# =============================================================================
# 后端镜像：多阶段构建
#
# 阶段 1 用 Maven 镜像编译打包，阶段 2 只把 jar 拷进 JRE 镜像。
# 为什么要分两阶段：Maven + 本地仓库约 700MB，而运行只需要 200MB 的 JRE。
# 单阶段构建出来的镜像会把整条工具链一起带上，答辩环境里拉镜像要多等好几分钟。
#
# 构建：docker build -f deploy/Dockerfile.backend -t g14/backend .
#       注意 context 是仓库根目录（build 时要能同时看到 backend/ 与 deploy/）
# =============================================================================

# ------------------------------- 构建阶段 -------------------------------
FROM maven:3.9-eclipse-temurin-17 AS build

WORKDIR /build

# 用阿里云镜像源拉 Maven 依赖。
# 国内直连 repo.maven.apache.org 经常几十 KB/s，一个 Spring Boot 工程要下
# 上百个包，实际会卡到十分钟以上甚至超时失败；镜像源能把这一步压到一两分钟。
# 放在 COPY pom.xml 之前，这样改代码不会让这一层失效。
# 用 printf 而不是 heredoc：heredoc 依赖 BuildKit 的 dockerfile:1.4 语法，
# 老一点的 docker 或关掉 BuildKit 时会直接报解析错误。
RUN mkdir -p /root/.m2 \
    && printf '%s\n' \
      '<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">' \
      '  <mirrors>' \
      '    <mirror>' \
      '      <id>aliyun</id>' \
      '      <url>https://maven.aliyun.com/repository/public</url>' \
      '      <mirrorOf>central</mirrorOf>' \
      '    </mirror>' \
      '  </mirrors>' \
      '</settings>' > /root/.m2/settings.xml

# 先只拷 pom.xml 并预热依赖：只要 pom 没变，改代码后重建可以直接命中这层缓存，
# 不用重新下载几十 MB 的依赖。这是分层构建最关键的一条优化。
COPY backend/pom.xml .
RUN mvn -B -q dependency:go-offline

COPY backend/src ./src
# -DskipTests：单元测试在提交前已跑过，镜像构建里再跑一遍只会让部署变慢
RUN mvn -B -q clean package -DskipTests

# ------------------------------- 运行阶段 -------------------------------
FROM eclipse-temurin:17-jre-jammy

WORKDIR /app

# 时区必须显式设置：容器默认 UTC，而日志、答卷提交时间、令牌过期都按东八区算，
# 不设的话「今天」的统计会从早上 8 点开始算。
ENV TZ=Asia/Shanghai \
    JAVA_OPTS="-XX:MaxRAMPercentage=75 -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 健康检查要用 wget / curl 之一，而 eclipse-temurin 的 jammy 基础镜像两个都不带
# （不像 nginx:alpine 自带 busybox wget）。这里显式装 wget：不到 2MB，
# 且比在 healthcheck 里拼 bash /dev/tcp 稳。没有它 healthcheck 永远失败，
# 容器会一直显示 unhealthy —— 服务其实是好的，但 `docker compose ps` 看着像挂了。
RUN apt-get update \
    && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/*

# 以非 root 运行：应用只需要写 /app/logs，没有理由给它 root 权限
RUN groupadd -r app && useradd -r -g app -d /app app \
    && mkdir -p /app/logs && chown -R app:app /app

COPY --from=build --chown=app:app /build/target/backend1-*.jar /app/app.jar

USER app

EXPOSE 8080

# exec 形式（shell 里套 exec）让 java 成为 1 号进程，能直接收到 SIGTERM，
# docker compose down 时才会优雅关闭连接池而不是等 10 秒被 SIGKILL。
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
